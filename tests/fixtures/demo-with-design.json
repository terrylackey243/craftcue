": [], "toolsNeeded": ["fine-point-cutting-tool"], "equipmentNeeded": [], "steps": ["Pick four simple 3 inch Halloween icons: pumpkin, ghost, cat, and moon.", "Cut one icon from vinyl per coaster using the fine-point tool on your mat.", "Weed each design carefully, keeping small details intact.", "Use transfer tape to lift each design and center it on a coaster.", "Burnish well so the edges stick down completely."], "designTips": "Search 'simple pumpkin silhouette' or 'farmhouse ghost icon' \u2014 keep shapes solid and chunky so small vinyl pieces don't lift.", "safetyNotes": ["Vinyl is not food or drink safe \u2014 coasters should only touch the outside of cups, not food or lips.", "Hand wash gently; skip the dishwasher so the vinyl doesn't lift."], "id": "proj-1", "goal": "decor", "goalContext": {}, "status": "idea", "aiGenerated": true, "createdAt": "2026-09-20T00:00:00.000Z", "updatedAt": "2026-09-21T00:00:00.000Z"}, {"title": "Kraft Pennant 'BOO' Banner", "summary": "A rustic kraft cardstock pennant banner spelling BOO in glittery gold letters, strung on navy ribbon for a farmhouse kitchen doorway or mantel.", "whyItFits": "Combines your kraft cardstock, glitter vinyl, and ribbon into a classic farmhouse banner, using both your cutting tool and scoring tool.", "difficulty": 2, "estMinutes": 60, "uses": [{"supplyId": "sup-11", "amount": 4, "unit": "sheet"}, {"supplyId": "sup-05", "amount": 0.5, "unit": "sheet"}, {"supplyId": "sup-27", "amount": 3, "unit": "yd"}, {"supplyId": "sup-29", "amount": 1, "unit": "bottle"}], "missing": [], "toolsNeeded": ["fine-point-cutting-tool", "scoring-tool"], "equipmentNeeded": [], "steps": ["Design a pennant (triangle with a flat top tab) about 5 inches wide and set a score line across the top tab.", "Cut four pennants from kraft cardstock, scoring the top fold line at the same time.", "Cut the letters B, O, O from gold glitter vinyl, sized to fit the pennants.", "Weed the letters and use transfer tape to apply one to each pennan